# Copy to keystore.properties (gitignored) to sign release builds with your Play upload key.
# Keep the .jks outside the repo and back it up; a relative path resolves from this folder.
storeFile=/Users/you/queueless-keys/queueless-upload.jks
storePassword=
keyAlias=queueless-upload
keyPassword=

# Google Play service account key (JSON) used by scripts/publish-android.sh. Keep it outside the repo.
playServiceAccountJson=/Users/you/queueless-keys/play-service-account.json
